# wispr-portal settings for a Linux lab host (copy to /etc/wispr-portal/portal.env).
# No secrets in this file: they are files under /etc/wispr-portal/secrets/.
PORTAL_MODE=debug
PORTAL_BACKEND=smartzone
BIND_ADDR=0.0.0.0
PORT=8080

SZ_NBI_HOSTS=192.168.37.6,192.168.37.8
SZ_NBI_PORT=9443
SZ_NBI_USERNAME=dha-nbi
SZ_NBI_PASSWORD_FILE=/etc/wispr-portal/secrets/sz_nbi_password
# SZ factory cert on 9443: leaf only, no SAN -> trust the leaf itself, check CN, pin it.
SZ_CA_BUNDLE=/etc/wispr-portal/secrets/sz9443-leaf.pem
SZ_TLS_SERVER_NAME=scg.ruckuswireless.com
SZ_CERT_SHA256=BD:09:8E:BC:D9:3C:B3:92:EE:7B:00:C5:A2:D5:F2:D5:CC:DA:4B:F3:38:C6:0B:2A:A3:13:C7:27:9D:A8:A7:05
SZ_AUTH_METHOD=login
SZ_GUEST_USERNAME=dha-guest

SECRET_KEY_FILE=/etc/wispr-portal/secrets/secret_key
EVENTS_TOKEN_FILE=/etc/wispr-portal/secrets/events_token
LOG_JSON_PATH=/var/log/wispr-portal/events.jsonl
LOG_CONSOLE=1

FACILITY_NAME=Demo Medical Center
# Run 2 (HTTPS): PORT=8443 plus
# TLS_CERT_FILE=/etc/wispr-portal/secrets/portal-cert.pem
# TLS_KEY_FILE=/etc/wispr-portal/secrets/portal-key.pem
