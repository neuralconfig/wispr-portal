# /etc/wispr-connector/<env>.env  (env = staging | production), mode 0640 root:wispr-connector.
# Two instances can run side by side: wispr-connector@staging and wispr-connector@production.

# Where to dial (production: wss://guest-connector.lanpulse.com/v1/connect).
CONNECTOR_URL=wss://guest-staging-connector.lanpulse.com/v1/connect
# The connector token (wpc_dha_...). Its SHA-256 is the Worker secret CONNECTOR_TOKEN_SHA256.
CONNECTOR_TOKEN_FILE=/etc/wispr-connector/secrets/staging.token
# Dial over IPv4 so the Worker sees the same NAT address the guests use (VLAN 739 is IPv4 only).
CONNECTOR_IP_FAMILY=4

# ---- Local policy ceiling: the cloud pushes the NBI config but can never widen these ----
ALLOWED_NBI_HOSTS=192.168.37.6,192.168.37.8
ALLOWED_NBI_PORT=9443
ALLOWED_METHODS=login,authorize
GUEST_CIDRS=10.7.39.0/24
MAX_NBI_PER_MIN=120

# Trust anchor for the SZ 9443 factory leaf, used when the cloud sends no ca_pem (the lab default).
# Same file as the VM portal's SZ_CA_BUNDLE.
SZ_CA_BUNDLE=/etc/wispr-connector/secrets/sz9443-leaf.pem

# Local health for RAMPART's portal.health (use 9181 for the second instance).
HEALTHZ_LISTEN=127.0.0.1:9180
